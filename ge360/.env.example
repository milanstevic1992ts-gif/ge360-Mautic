COMPOSE_PROJECT_NAME=ge360-mautic

MAUTIC_IMAGE=mautic/mautic:7.2-apache
DB_IMAGE=mariadb:10.11
MAUTIC_BIND=127.0.0.1
MAUTIC_PORT=8793
GE360_BRIDGE_BIND=127.0.0.1
GE360_BRIDGE_PORT=8794

MYSQL_DATABASE=mautic
MYSQL_USER=mautic
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DOCKER_MAUTIC_LOAD_TEST_DATA=false

GE360_BRIDGE_TOKEN=

# Existing GE360 services. Leave blank when a service is not installed yet.
GE360_PROSPEX_URL=
GE360_SUITECRM_URL=
GE360_N8N_URL=
GE360_JARVIS_URL=

# n8n workflow endpoints used by the lightweight bridge.
N8N_PROSPEX_WEBHOOK_URL=
N8N_MAUTIC_WEBHOOK_URL=
